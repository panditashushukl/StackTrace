# ==============================================================================
# StackTrace Buddy Backend Environment Template
# Copy to .env and fill in production secrets.
# ==============================================================================

SERVER_PORT=8080

# PostgreSQL Database & HikariCP Pool
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stacktrace_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-in-production
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true

# Google Gemini AI & Fallback Models
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096

# Gemini Transient Retry Backoff (HTTP 429 / 503)
GEMINI_RETRY_MAX_ATTEMPTS=3
GEMINI_RETRY_INITIAL_INTERVAL=1000ms
GEMINI_RETRY_MULTIPLIER=2
GEMINI_RETRY_MAX_INTERVAL=8000ms

# Security, JWT & Google OAuth2
JWT_SECRET=replace-with-base64-encoded-256bit-secret
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend & CORS
FRONTEND_REDIRECT_URI=https://your-domain.example/auth/callback
ALLOWED_ORIGINS=https://your-domain.example
MAX_PAYLOAD_BYTES=102400
